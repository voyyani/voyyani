{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "voyani.tech" }],
      "destination": "https://www.voyani.tech/$1",
      "statusCode": 301
    },
    {
      "source": "/Karisa-Voyani-Resume.pdf",
      "destination": "/Ngowa-Karisa-Resume.pdf",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.(?:js|mjs|css|json|xml|txt|ico|png|jpg|jpeg|webp|avif|svg|gif|pdf|woff|woff2|ttf|eot|map|webmanifest)$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
