# ══════════════════════════════════════════════════════════════════════════
#  voyani.tech — environment template
# ══════════════════════════════════════════════════════════════════════════
#
#  DO NOT PUT REAL VALUES IN THIS FILE. It is the one env file .gitignore
#  does not ignore (see the `!.env.example` line), so anything you type here
#  gets committed.
#
#      cp .env.example .env.local     # .env.local IS ignored — fill that in
#
#  Frontend vars (VITE_*) are compiled into the public bundle and are safe to
#  expose. Everything under SERVER-SIDE is a real secret: it lives only in
#  Supabase, never in the bundle, never in git.
#
#  Full context: docs/EMAIL_ROADMAP.md
# ══════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────
#  1. FRONTEND — Supabase           (goes in .env.local AND in Vercel)
# ─────────────────────────────────────────────────────────────────────────
#  Supabase dashboard → Project Settings → API
#
#  The anon key is public by design; row-level security is what protects the
#  data. NEVER put the service_role key in a VITE_ variable — it bypasses RLS
#  and would ship to every visitor.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional
# VITE_GA_ID=
# VITE_SENTRY_DSN=


# ─────────────────────────────────────────────────────────────────────────
#  2. SERVER-SIDE — Supabase Edge Function secrets
# ─────────────────────────────────────────────────────────────────────────
#  Fill these into .env.local, then push them with:
#
#      ./scripts/push-email-secrets.sh
#
#  Never paste them into a terminal directly — shell history keeps them.
#  SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform;
#  do not set them yourself.

# Supabase → Project Settings → General → Reference ID (20 chars)
SUPABASE_PROJECT_REF=

# Resend → API Keys → Create API Key
#   Name:       voyani-portfolio-prod
#   Permission: Sending access
#   Domain:     voyani.tech
# Shown exactly once. Starts with re_
RESEND_API_KEY=

# Resend → Webhooks → the endpoint's Signing Secret. Starts with whsec_
# Register TWO endpoints against this secret:
#   https://<ref>.supabase.co/functions/v1/handle-inbound-email   → email.received
#   https://<ref>.supabase.co/functions/v1/handle-resend-webhook  → email.sent,
#       email.delivered, email.opened, email.clicked, email.bounced,
#       email.complained, email.failed
# If Resend issues a DIFFERENT secret per endpoint, stop and say so — the
# functions currently share one name.
RESEND_WEBHOOK_SECRET=

# Signing secret of the SECOND endpoint (handle-resend-webhook, delivery events).
# Resend issues one secret per endpoint, so this is not the same value as above.
# Starts with whsec_
RESEND_STATUS_WEBHOOK_SECRET=

# Where mail actually gets read. Inbound mail to the domain is forwarded here.
# Stays a Gmail address; it is NOT published on the site.
ADMIN_EMAIL=voyanitech@gmail.com

# Sending identity. MAIL_FROM_ADDRESS must be on the Resend-verified domain.
MAIL_DOMAIN=voyani.tech
MAIL_FROM_ADDRESS=karisa@voyani.tech
MAIL_FROM_NAME=Karisa

# Canonical host — the www form. The bare apex 301-redirects to it.
PORTFOLIO_URL=https://www.voyani.tech
DASHBOARD_URL=https://www.voyani.tech/admin/submissions

# Turns on production strictness inside the edge functions.
DENO_ENV=production


# ─────────────────────────────────────────────────────────────────────────
#  3. CLOUDFLARE DNS — records to add by hand
# ─────────────────────────────────────────────────────────────────────────
#  Not environment variables; a checklist. Cloudflare → voyani.tech → DNS.
#
#  FIRST: Cloudflare → Email → Email Routing must be DISABLED. If it is on it
#  will overwrite the root MX in (d) and silently steal all inbound mail.
#
#  Cloudflare appends the zone automatically — enter the Name column exactly
#  as written below ("send", not "send.voyani.tech").
#
#  Proxy status does not apply to MX/TXT. If any shows an orange cloud, set
#  it to "DNS only".
#
#  ── SENDING (values come from Resend → Domains → voyani.tech) ──
#
#   (a)  MX    send                <copy from Resend>            priority 10
#             expect: feedback-smtp.us-east-1.amazonses.com
#
#   (b)  TXT   send                v=spf1 include:amazonses.com ~all
#
#   (c)  TXT   resend._domainkey   <copy from Resend — long, unique to your
#                                   account, cannot be guessed>
#             Paste as ONE unbroken string. Do not add quotes, do not split
#             it — Cloudflare handles the 255-char chunking itself.
#
#  ── RECEIVING (value comes from Resend → Inbound) ──
#
#   (d)  MX    @                   <copy from Resend>            priority 10
#             expect: inbound.resend.com
#             This is the ROOT MX. It does not conflict with (a), which sits
#             on the send. subdomain.
#
#  ── POLICY (type this one yourself) ──
#
#   (e)  TXT   _dmarc              v=DMARC1; p=none; rua=mailto:voyanitech@gmail.com; fo=1
#             p=none reports without quarantining, so a misconfiguration does
#             not silently eat mail. Tighten to p=quarantine after a week of
#             clean reports.
#
#  ── VERIFY (all five must return a value before clicking Verify) ──
#
#      dig +short MX  send.voyani.tech
#      dig +short TXT send.voyani.tech
#      dig +short TXT resend._domainkey.voyani.tech
#      dig +short MX  voyani.tech
#      dig +short TXT _dmarc.voyani.tech
#
#  Empty output means Cloudflare has not propagated — wait 5 min, re-run.
#  Do not click Verify in Resend on empty output.
